{
  "name": "dotfiles",
  "private": true,
  "packageManager": "pnpm@11.13.1+sha512.b2fc7683b8a6525414e7d13e1ba28caaddde96bf66ec540bfaeb7e702b81f3e0be4d1f295edf7f9fe0396740a8dce4509c582ddf79891f4543fea32d37645f25",
  "scripts": {
    "check": "make check",
    "format": "make format",
    "format:check": "make format-check",
    "lint": "make lint",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.py": [
      "uv run --no-active --project dot_config/exact_nvim/lua/django-orm-analyzer ruff format",
      "uv run --no-active --project dot_config/exact_nvim/lua/django-orm-analyzer ruff check --fix --no-cache",
      "uv run --no-active --project dot_config/exact_nvim/lua/django-orm-analyzer mypy --config-file dot_config/exact_nvim/lua/django-orm-analyzer/pyproject.toml"
    ],
    "*.{md,json,yml,yaml}": "prettier --write --ignore-unknown --config dot_prettierrc.toml",
    "*.md": "markdownlint-cli2 --config dot_markdownlint.toml",
    "*.toml": [
      "tombi format",
      "tombi lint --error-on-warnings"
    ],
    "*.lua": "stylua --config-path dot_config/exact_nvim/stylua.toml",
    "*.sh": [
      "shfmt -w -i 4 -ci -bn",
      "shellcheck"
    ],
    "{./dot_zshenv,dot_config/exact_borders/executable_bordersrc}": [
      "shfmt -w -i 4 -ci -bn",
      "shellcheck"
    ],
    "{dot_config/zsh/dot_zprofile,dot_config/zsh/dot_zshenv,dot_config/zsh/dot_zshrc,dot_config/zsh/*.zsh,dot_config/exact_fzf/fzf.zsh}": [
      "shfmt -w -ln zsh -i 2",
      "zsh -n"
    ]
  },
  "devDependencies": {
    "@johnnymorganz/stylua-bin": "^2.5.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.8.3",
    "tombi": "^1.2.4"
  }
}
