#!/bin/zsh

setopt extendedglob autocd interactivecomments
setopt appendhistory sharehistory hist_ignore_space hist_ignore_all_dups \
  hist_save_no_dups hist_ignore_dups hist_find_no_dups

mkdir -p "$XDG_CACHE_HOME/zsh" "$XDG_STATE_HOME/zsh" "$XDG_RUNTIME_DIR/npm"

HISTSIZE=500000
SAVEHIST=$HISTSIZE
HISTFILE="${XDG_STATE_HOME}/zsh/history"

export EDITOR="nvim"
export VISUAL="nvim"
export BAT_THEME="Catppuccin Mocha"
export EZA_COLORS="uu=36:gu=37:sn=32:sb=32:da=34:ur=34:uw=35:ux=36:ue=36:gr=34:gw=35:gx=36:tr=34:tw=35:tx=36:"
export DOCKER_BUILDKIT=1
export COMPOSE_DOCKER_CLI_BUILD=1
export DOCKER_CLI_HINTS=false
export COMPOSE_MENU=false

# Aliases
## Editor
alias c="clear"
alias vim="nvim"
alias vimdiff="nvim -d"
command -v bat >/dev/null 2>&1 && alias cat="bat -pp"
command -v lazygit >/dev/null 2>&1 && alias lg="lazygit"
command -v wget >/dev/null 2>&1 && alias wget='wget --hsts-file="$XDG_DATA_HOME/wget-hsts"'

## Kubernetes
command -v kubectl >/dev/null 2>&1 && alias k="kubectl"
command -v kubectl >/dev/null 2>&1 && alias kgp="kubectl get pods"
command -v kubectl >/dev/null 2>&1 && alias kgs="kubectl get services"
command -v kubectl >/dev/null 2>&1 && alias kd="kubectl describe"
command -v kubectl >/dev/null 2>&1 && alias kdel="kubectl delete"
command -v kubectl >/dev/null 2>&1 && alias kctx="kubectx"
command -v kubectl >/dev/null 2>&1 && alias kns="kubens"
command -v kubectl >/dev/null 2>&1 && alias klogs="kubectl logs -f"
command -v kubectl >/dev/null 2>&1 && alias kexec="kubectl exec -it"
command -v kubectl >/dev/null 2>&1 && alias kcp="kubectl cp"
command -v kubectl >/dev/null 2>&1 && alias ktop="kubectl top pods"

## Git
# Creates or updates a tag at HEAD and force-pushes it to the remote.
#
# Arguments:
#   1: Tag name to create or update.
#   2: Remote name (optional, defaults to origin).
# Outputs:
#   Usage message to stderr if tag is not provided.
# Returns:
#   0 on success; non-zero on failure or missing arguments.
tagpush() {
  command -v git >/dev/null 2>&1 || {
    print -u2 "tagpush: git not found"
    return 1
  }

  if [[ -z "${1:-}" || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    print -u2 "Usage: tagpush <tag> [remote]"
    return 1
  fi

  local tag="$1"
  local remote="${2:-origin}"

  git tag -f "$tag" && git push "$remote" "$tag" --force
}

typeset -U fpath FPATH
[[ -d "${DOCKER_CONFIG}/completions" ]] && fpath=("${DOCKER_CONFIG}/completions" $fpath)
[[ -d "$ZDOTDIR/functions" ]] && fpath=("$ZDOTDIR/functions" $fpath)
for _site_functions in /opt/homebrew/share/zsh/site-functions /usr/local/share/zsh/site-functions "$DOTFILES_NIX_PROFILE/share/zsh/site-functions"; do
  [[ -d "$_site_functions" ]] && fpath=("$_site_functions" $fpath)
done
unset _site_functions

zstyle ':completion:*' menu select
zstyle ':completion:*' group-name ''
zstyle ':completion:*' list-dirs-first true
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*:warnings' format '%F{203}no matches for:%f %d'
zstyle ':completion:*:corrections' format '%F{yellow}!- %d (errors: %e) -!%f'
zstyle ':completion:*:messages' format ' %F{purple} -- %d --%f'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$XDG_CACHE_HOME/zsh/completions"
zstyle ':completion:*:git-checkout:*' sort false

# ^Xa to insert all matches
zle -C all-matches complete-word _generic
bindkey '^Xa' all-matches
zstyle ':completion:all-matches:*' old-matches only
zstyle ':completion:all-matches::::' completer _all_matches

[[ -n "${LS_COLORS:-}" ]] && zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}

autoload -Uz compinit edit-command-line up-line-or-beginning-search down-line-or-beginning-search
compinit -i -d "$XDG_CACHE_HOME/zsh/zcompdump-${ZSH_VERSION}"

bindkey -v
export KEYTIMEOUT=1
zle -N edit-command-line
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey -M vicmd 'v' edit-command-line
bindkey '^p' up-line-or-beginning-search
bindkey '^n' down-line-or-beginning-search
bindkey -M vicmd '^p' up-line-or-beginning-search
bindkey -M vicmd '^n' down-line-or-beginning-search

if [[ -r "$XDG_CONFIG_HOME/fzf/fzf.zsh" ]] || command -v fzf >/dev/null 2>&1; then
  if command -v fd >/dev/null 2>&1; then
    export FZF_DEFAULT_COMMAND="fd --type f --hidden --follow --exclude .git"
  else
    export FZF_DEFAULT_COMMAND="find . -path '*/.git' -prune -o -type f -print"
  fi
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_DEFAULT_OPTS=" \
--height=40% --layout=reverse --border --info=inline-right \
--color=bg:#1e1e2e,bg+:#313244,spinner:#f5c2e7,hl:#89b4fa \
--color=fg:#cdd6f4,header:#94e2d5,info:#bac2de,pointer:#f5e0dc \
--color=marker:#a6e3a1,fg+:#f5e0dc,prompt:#89b4fa,hl+:#cba6f7,border:#45475a"
  # fzf --zsh registers zle widgets, so only load it for real terminals.
  [[ -t 0 && -t 1 && -r "$XDG_CONFIG_HOME/fzf/fzf.zsh" ]] && source "$XDG_CONFIG_HOME/fzf/fzf.zsh"

  if zle -l fzf-completion >/dev/null 2>&1; then
    bindkey -M emacs '^I' fzf-completion
    bindkey -M viins '^I' fzf-completion
    bindkey -M vicmd '^I' fzf-completion
  fi
fi

_source_first() {
  local file
  for file in "$@"; do
    [[ -r "$file" ]] && source "$file" && return 0
  done
  return 1
}

# Keep Nix's Node as the default; load NVM only when explicitly requested.
nvm() {
  if [[ ! -r "$NVM_DIR/nvm.sh" ]]; then
    print -u2 "nvm: run chezmoi apply to install NVM into $NVM_DIR"
    return 1
  fi
  unfunction nvm
  source "$NVM_DIR/nvm.sh" --no-use || return
  nvm "$@"
}

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

if [[ -z "${STARSHIP_SHELL:-}" && "${TERM:-}" != "dumb" ]] && command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook zsh)"
fi

# Attaches to or creates a tmux session, letting continuum handle restore.
t() {
  local session="${1:-}"

  if [[ -n "$session" ]]; then
    if [[ -n "${TMUX:-}" ]]; then
      tmux has-session -t "$session" 2>/dev/null || tmux new-session -d -s "$session"
      tmux switch-client -t "$session"
    else
      tmux new-session -A -s "$session"
    fi
    return
  fi

  if [[ -n "${TMUX:-}" ]]; then
    local current_session
    current_session="$(tmux display-message -p '#S')"
    local target
    target=$(tmux list-sessions -F "#{session_name}" 2>/dev/null | grep -v "^${current_session}$" | fzf --reverse --header="Switch tmux session")
    [[ -n "$target" ]] && tmux switch-client -t "$target"
    return
  fi

  if tmux has-session 2>/dev/null; then
    local sessions
    sessions="$(tmux list-sessions -F "#{session_name}" 2>/dev/null)"
    if [[ "$(echo "$sessions" | wc -l | tr -d ' ')" -eq 1 ]]; then
      tmux attach-session -t "$sessions"
    else
      local target
      target=$(echo "$sessions" | fzf --reverse --header="Select tmux session")
      [[ -n "$target" ]] && tmux attach-session -t "$target"
    fi
  else
    tmux new-session -A -s main
  fi
}

# Work/personal account helpers; account IDs stay in .zshenv.local.
[[ -r "$ZDOTDIR/onepassword.zsh" ]] && source "$ZDOTDIR/onepassword.zsh"

typeset -gA ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[command]="fg=#89b4fa,bold"
ZSH_HIGHLIGHT_STYLES[builtin]="fg=#cba6f7"
ZSH_HIGHLIGHT_STYLES[alias]="fg=#f9e2af"
ZSH_HIGHLIGHT_STYLES[path]="fg=#94e2d5"
ZSH_HIGHLIGHT_STYLES["unknown-token"]="fg=#f38ba8,bold"

_source_first \
  "$DOTFILES_NIX_PROFILE/share/zsh-autosuggestions/zsh-autosuggestions.zsh" \
  /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
  /usr/local/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
  "$XDG_DATA_HOME/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" >/dev/null 2>&1 || true

[[ -f "$ZDOTDIR/.zshrc.local" ]] && source "$ZDOTDIR/.zshrc.local"
for local_config in "$ZDOTDIR/.zshrc.d"/*.zsh(N); do
  source "$local_config"
done
unset local_config

_source_first \
  "$DOTFILES_NIX_PROFILE/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" \
  /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
  /usr/local/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
  "$XDG_DATA_HOME/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" >/dev/null 2>&1 || true

if [[ -o login ]]; then
  if command -v fastfetch >/dev/null 2>&1; then
    fastfetch
  elif command -v eza >/dev/null 2>&1; then
    eza -lah --git --group-directories-first --icons --no-user --no-time -TL 1
  fi
fi
